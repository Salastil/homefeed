# Copy to .env (same directory as docker-compose.yml) — Compose reads it
# automatically for the ${VAR} substitutions below. See README.md "Docker".

# The one public-facing URL used for everything: the backend's CORS check
# (FRONTEND_ORIGIN), adapter-node's own origin validation (ORIGIN), and — since
# the frontend container shares the backend container's network namespace (see
# docker-compose.yml) — also what both the browser and the frontend's own
# server-rendered requests use to reach the backend (VITE_BACKEND_URL).
#
# For local testing on your own machine, the defaults below (matching the
# published ports) already work as-is. For a real deployment, put both
# containers behind a reverse proxy on one public domain and set PUBLIC_ORIGIN
# (and VITE_BACKEND_URL, if routing by path — see README.md) to that domain,
# same as the non-Docker deployment instructions.
PUBLIC_ORIGIN=http://localhost:3000

# Baked into the frontend image at BUILD time, not read at container start —
# changing this needs `docker compose build frontend`, not just a restart.
VITE_BACKEND_URL=http://localhost:4000

# Host ports to publish (both are published on the backend container — see
# docker-compose.yml's network_mode note).
FRONTEND_PORT=3000
BACKEND_PORT=4000

# Turns on the admin cog icon + /admin/* pages — off by default, matching the
# non-Docker deployment. The backend's per-launch API key (printed to
# `docker compose logs backend` on every start) is what actually protects
# /api/admin/* either way.
ADMIN_PANEL_ENABLED=false

# Optional — unlocks "private" categories for visitors who log in with this
# password on the public site's lock icon. Leave unset/blank to disable private
# categories entirely.
# PRIVATE_ACCESS_PASSWORD=

# Where `docker compose build`/`push`/`pull` read/write the two images —
# defaults to this project's Gitea container registry (same host as the git
# server). CI (.gitea/workflows/docker-build.yml) sets IMAGE_TAG to the branch
# name and pushes `latest` on master; override either for a different registry
# or a specific tag to deploy.
# REGISTRY=git.salastil.com/salastil
# IMAGE_TAG=latest
